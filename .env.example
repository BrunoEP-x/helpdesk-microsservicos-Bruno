# Copie para .env e ajuste. O arquivo .env nunca deve ir para o GitHub.
# Nenhuma variável é obrigatória: sem .env, o docker compose sobe com os padrões abaixo.

# Segredo que assina os tokens de login (mínimo 32 caracteres), IGUAL em todos os serviços.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vazio = o contêiner "segredos" gera um aleatório na primeira subida e guarda num volume.
JWT_SEGREDO=

# Tempo de validade do login, em minutos
TOKEN_MINUTOS=60

# 1 = cria usuários, equipamentos e chamados de exemplo (só para aula)
DADOS_EXEMPLO=1
# Senha dos usuários de exemplo
SENHA_EXEMPLO=Helpdesk2026
# Com DADOS_EXEMPLO=0, cria o primeiro administrador com estes dados
ADMIN_EMAIL=
ADMIN_SENHA=

# 0 = desliga a documentação /docs de cada serviço (recomendado em produção)
DOCS=1

# Tempo limite (segundos) das chamadas entre serviços
TIMEOUT_HTTP=3
# Intervalo (segundos) da verificação automática de SLA
INTERVALO_VERIFICACAO_SLA=60
# Fuso (horas) usado para agrupar o gráfico diário do painel
FUSO_HORAS=-3

# E-mail das notificações (opcional; sem SMTP_HOST os avisos ficam só na tela)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=helpdesk@empresa.com
